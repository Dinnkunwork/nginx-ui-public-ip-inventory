{
  "$schema": "https://raw.githubusercontent.com/nginxui/plugin-spec/main/schema/plugin.schema.json",
  "id": "com.company.public-ip-inventory",
  "name": "Public IP Inventory",
  "version": "1.0.1",
  "api_version": 1,
  "description": "Centralized manual inventory of company and client Public IP addresses (IPv4/IPv6) with dashboard, search/filter, CSV reporting, and SQLite backup.",
  "author": "Infrastructure Team",
  "license": "MIT",
  "capabilities": [
    "http"
  ],
  "http": {
    "listen": "unix"
  },
  "server": {
    "command": [
      "python3",
      "bin/public-ip-inventory-server"
    ]
  },
  "webapp": {
    "bundle_path": "webapp/dist/main.js",
    "shared": {
      "vue": ">=3.5.0 <4",
      "vue-router": ">=4.5.0 <6",
      "antdv-next": ">=1.5.0 <2"
    }
  },
  "permissions": [],
  "network_hosts": [],
  "settings_schema": {
    "settings": [
      {
        "key": "db_path",
        "type": "text",
        "display_name": "SQLite Database Path",
        "help_text": "Custom path for public-ip-inventory.db (leave empty to use plugin data directory)"
      },
      {
        "key": "backup_dir",
        "type": "text",
        "display_name": "Backup Directory",
        "help_text": "Directory for SQLite backups (defaults to <db_dir>/backups)"
      }
    ]
  }
}
